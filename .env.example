# Backend (Render)
NODE_ENV=production
SERVER_PORT=4000
MONGODB_URI=mongodb+srv://usuario:clave@cluster/dankar
# Genera uno con: openssl rand -hex 32
JWT_SECRET=
# Genera con: node server/scripts/hash-password.js
ADMIN_PASSWORD_HASH=
SESION_HORAS=12
ORIGENES_PERMITIDOS=https://dankar.vercel.app

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# IA para escribir descripciones (Groq, compatible con la API de OpenAI).
# Sin GROQ_API_KEY el botón "Escribir con IA" no aparece en el panel.
GROQ_API_KEY=
IA_MODELO=llama-3.3-70b-versatile
# true solo si el modelo ve imágenes (ej. meta-models/muse-spark-open)
IA_VISION=false
