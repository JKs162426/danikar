# Backend (Render)
NODE_ENV=production
SERVER_PORT=4000
MONGODB_URI=mongodb+srv://usuario:clave@cluster/dankar
# Genera uno con: openssl rand -hex 32
JWT_SECRET=
# Genera con: node server/scripts/hash-password.js
ADMIN_PASSWORD_HASH=
SESION_HORAS=12
ORIGENES_PERMITIDOS=https://dankar.vercel.app

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# IA para escribir descripciones mirando la foto (Groq, compatible con la
# API de OpenAI). Sin la clave, el botón "Escribir con IA" no aparece.
GROQ_API_KEY=
IA_MODELO=qwen/qwen3.8-27b
# false si el modelo solo lee texto
IA_VISION=true
# Fotos por pedido (~1.800 tokens cada una; el plan gratuito da 7.000/min)
IA_MAX_FOTOS=1
